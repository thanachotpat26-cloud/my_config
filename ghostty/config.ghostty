font-size = 22

# window
maximize = true
window-decoration = false
window-width = 999
window-height = 999
window-padding-x = 8
window-padding-y = 4

cursor-style = block 
cursor-style-blink = true

# background
background-opacity = 1

# performance
mouse-hide-while-typing = true
confirm-close-surface = false
clipboard-read = allow
